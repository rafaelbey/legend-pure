import meta::pure::test::pct::*;

native function <<PCT.function, PCT.platformOnly>> meta::pure::functions::collection::replaceTreeNode(root:TreeNode[1], target:TreeNode[1], value:TreeNode[1]):TreeNode[1];

function <<test.Test>> meta::pure::functions::collection::tests::tree::testReplaceTreeNodeChild():Boolean[1]
{
   // Build a 2-level tree:        root
   //                              /  \
   //                          child1  child2
   // Replace `child1` with a fresh leaf and check the new root has
   // {replacement, child2} as its childrenData (the originals stay
   // intact — persistent copy).
   let child1 = ^TreeNode();
   let child2 = ^TreeNode();
   let root = ^TreeNode(childrenData = [$child1, $child2]);
   let replacement = ^TreeNode();
   let newRoot = replaceTreeNode($root, $child1, $replacement);
   assertEquals(2, $newRoot.childrenData->size());
   assertIs($replacement, $newRoot.childrenData->at(0));
   assertIs($child2, $newRoot.childrenData->at(1));
   // Source tree must be untouched (persistent semantics).
   assertEquals(2, $root.childrenData->size());
   assertIs($child1, $root.childrenData->at(0));
}

function <<test.Test>> meta::pure::functions::collection::tests::tree::testReplaceTreeNodeRoot():Boolean[1]
{
   // Replacing the root itself returns `value` unchanged.
   let root = ^TreeNode();
   let replacement = ^TreeNode();
   let newRoot = replaceTreeNode($root, $root, $replacement);
   assertIs($replacement, $newRoot);
}

function <<test.Test>> meta::pure::functions::collection::tests::tree::testReplaceTreeNodeNotFoundErrors():Boolean[1]
{
   // Target not in source tree must raise.
   let root = ^TreeNode();
   let orphan = ^TreeNode();
   let replacement = ^TreeNode();
   assertError(
      |replaceTreeNode($root, $orphan, $replacement),
      'replaceTreeNode: target node not found in source tree'
   );
}
