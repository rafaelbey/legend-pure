import meta::pure::test::pct::*;

native function <<PCT.function, PCT.platformOnly>> meta::pure::functions::meta::tag(profile:Profile[1], str:String[1]):Tag[1];

function <<test.Test>> meta::pure::functions::meta::tests::profile::testTagLookup():Boolean[1]
{
   // `meta::pure::profiles::test` declares `excludePlatform` as a tag.
   // Lookup returns a Tag whose `value` is the tag name and whose
   // `profile` points back to the originating Profile.
   let t = tag(meta::pure::profiles::test, 'excludePlatform');
   assertEquals('excludePlatform', $t.value);
   assertEquals(meta::pure::profiles::test, $t.profile);
}

function <<test.Test>> meta::pure::functions::meta::tests::profile::testTagUnknownErrors():Boolean[1]
{
   // Unknown tag on a known profile must raise.
   assertError(
      |tag(meta::pure::profiles::test, 'noSuchTag'),
      'tag: \'noSuchTag\' is not declared on Profile meta::pure::profiles::test'
   );
}
