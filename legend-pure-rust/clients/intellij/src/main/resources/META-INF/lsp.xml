<!--
  Loaded only when com.intellij.modules.lsp is available (declared as an
  optional dependency from plugin.xml). Keeps the LSP-specific extension
  point isolated so the rest of the plugin can install on any IDE that
  recognizes .pure files, even without the LSP runtime.
-->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij.platform">
        <lsp.serverSupportProvider
                implementation="org.finos.legend.pure.intellij.PureLspServerSupportProvider"/>
    </extensions>
    <!--
      No custom Goto Symbol / Goto Class contributor needed: 2025.3
      ships native LSP→Search Everywhere wiring (`LspGoToSymbolContributor`
      / `LspGoToClassContributor`, ticket IJPL-189547). Cmd+O,
      Cmd+Alt+O, and the Symbols + Classes tabs route through the
      stock platform contributors and read our server's
      `workspace/symbol` capability automatically.

      We had a custom contributor for the 2025.2 fallback path; it
      was deleted alongside the `pluginSinceBuild` bump from 252 to
      253. If we ever need to support 2025.2 again, restore it from
      git history (commit message will mention `PureGotoSymbolContributor`).
    -->
</idea-plugin>
