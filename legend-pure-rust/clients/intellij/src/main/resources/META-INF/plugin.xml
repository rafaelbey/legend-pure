<idea-plugin>
    <id>org.finos.legend.pure.intellij</id>
    <name>Legend Pure</name>
    <vendor email="legend@finos.org" url="https://legend.finos.org">FINOS</vendor>

    <description><![CDATA[
        IntelliJ support for the
        <a href="https://github.com/finos/legend-pure">Legend Pure</a>
        modeling language, backed by the <code>legend lsp</code>
        language server (Rust implementation).<br/>
        <br/>
        Tier-1 features: diagnostics, hover, goto definition, document
        outline, and <code>legend.runTest</code> code lenses.<br/>
        <br/>
        Requires <b>IntelliJ IDEA 2025.2.1 or later</b> (build 252.25557+).
        From that build forward the LSP API ships in the unified IDEA
        distribution and is available to both Ultimate subscribers and
        free-tier users.
    ]]></description>

    <change-notes><![CDATA[
        <h3>0.1.0 — initial MVP</h3>
        <ul>
            <li>Spawns <code>legend lsp</code> over stdio.</li>
            <li>Configurable executable path (default: PATH lookup).</li>
            <li>Optional classpath TOML override (default: server cascade).</li>
        </ul>
    ]]></change-notes>

    <!-- Required platform module. -->
    <depends>com.intellij.modules.platform</depends>

    <!-- LSP module is declared optional so the plugin can load on IDEs
         that lack the LSP runtime; the LSP-specific extension points
         live in lsp.xml and are only loaded when the module is present.
         JetBrains' recommended shape since the 2025.2.1 LSP-for-all
         announcement. -->
    <depends optional="true" config-file="lsp.xml">com.intellij.modules.lsp</depends>

    <!-- DAP module dependency.
         The `intellij.platform.dap` module is a v2 content module —
         it has no `<module value="...">` virtual marker, so the
         v1-style `<depends>` directive can't resolve it. The v2
         `<dependencies>` block below is the supported way to pull
         a bundled content module onto the plugin classloader. The
         debugger EPs are registered directly in this file's
         `<extensions>` section; they only fire when the module is
         loaded, which the v2 dependency ensures. -->
    <dependencies>
        <module name="intellij.platform.dap"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <!-- File-type registration -->
        <fileType
                name="Pure"
                language="Pure"
                extensions="pure"
                fileNames=""
                implementationClass="org.finos.legend.pure.intellij.PureFileType"
                fieldName="INSTANCE"/>

        <!-- Syntax highlighting (lexer-based, no LSP roundtrip) -->
        <lang.syntaxHighlighterFactory
                language="Pure"
                implementationClass="org.finos.legend.pure.intellij.highlighting.PureSyntaxHighlighterFactory"/>

        <!-- Minimal PSI layer. Required for ⌘-hover navigation hints
             and ⌘-click goto: IntelliJ's GoTo Declaration pipeline
             needs a PSI tree to know the cursor is on a token before
             it routes the request to the LSP server. The parser
             produces a flat tree (no grammar structure) — semantics
             stay with `legend lsp`. -->
        <lang.parserDefinition
                language="Pure"
                implementationClass="org.finos.legend.pure.intellij.PureParserDefinition"/>

        <!-- Project-level settings -->
        <projectService
                serviceImplementation="org.finos.legend.pure.intellij.settings.LegendPureSettings"/>

        <!-- Settings UI -->
        <projectConfigurable
                parentId="language"
                instance="org.finos.legend.pure.intellij.settings.LegendPureConfigurable"
                id="org.finos.legend.pure.intellij.settings"
                displayName="Legend Pure"/>

        <!-- Notification group for run / test results.
             `PureRunCommandsSupport` looks up this group by id when
             surfacing subprocess output as a balloon. Type BALLOON
             so the user sees a transient pop-up; the full log
             remains in the Notifications tool-window. -->
        <notificationGroup
                id="Legend Pure"
                displayType="BALLOON"/>

        <!-- Persistent tool window for ▶ Run / Run Test / Run PCT
             output. Each invocation appends a new tab carrying a
             `ConsoleView` so stack frames render as native
             clickable hyperlinks (the same affordance Java /
             Kotlin run-configurations use). The balloon
             notification stays as a transient 1-line summary. -->
        <toolWindow
                id="Legend Pure Run"
                anchor="bottom"
                icon="AllIcons.RunConfigurations.TestState.Run"
                canCloseContents="true"
                factoryClass="org.finos.legend.pure.intellij.run.PureRunToolWindowFactory"/>

        <!-- ▶ Run gutter icon for runnable Pure functions.
             IntelliJ's stock LSP integration (still in 2025.3)
             doesn't have a code-lens consumer, so the server's
             `legend.run` / `legend.runTest` / `legend.runPCT`
             lenses go unrendered by the platform. This
             contributor fetches the same lenses via
             `textDocument/codeLens` (cached per buffer-version
             in `LegendRunnableCache`) and renders them through
             the `runLineMarkerContributor` EP — same surface
             Kotlin / Java's `fun main()` ▶ icon plugs into. -->
        <runLineMarkerContributor
                language="Pure"
                implementationClass="org.finos.legend.pure.intellij.run.PureRunLineMarkerContributor"/>

        <!-- Line-breakpoint type for `.pure`. Lives under the
             core `com.intellij` namespace (the xdebugger module
             is always loaded), even though it's only useful when
             the DAP module is also present. -->
        <xdebugger.breakpointType
                implementation="org.finos.legend.pure.intellij.debug.PureLineBreakpointType"/>

        <!-- Console-output linkifier. Scans Run/Debug console
             text for the runtime's stack-frame pattern
             (`resource:PATH line:N column:M`) and turns it into
             a clickable jump-to-source link. Mirrors the
             post-failure link rendering in the Pure Run tool
             window for streaming output during a debug session. -->
        <consoleFilterProvider
                implementation="org.finos.legend.pure.intellij.debug.PureDebugConsoleFilterProvider"/>

        <!-- Tells `WolfTheProblemSolver` that `.pure` files are
             highlightable. Without this, `reportProblems` calls
             from the LSP cross-file diagnostics path
             (`WorkspaceAwareLspNotificationsHandler`) are
             silently dropped by Wolf's `isToBeHighlighted`
             filter — files would never appear in the Problems
             tool window or get the red-filename badge in
             Project view. T-20260511-06 / global diagnostics. -->
        <problemFileHighlightFilter
                implementation="org.finos.legend.pure.intellij.PureProblemFileHighlightFilter"/>
    </extensions>

    <!-- DAP-specific EPs. Only register when the
         `intellij.platform.dap` module is on the classloader,
         which the v2 `<dependencies>` block at the top of this
         file guarantees. -->
    <extensions defaultExtensionNs="com.intellij.platform.dap">
        <debugAdapterSupportProvider
                implementation="org.finos.legend.pure.intellij.debug.PureDebugAdapterSupportProvider"/>
        <launchArgumentsProvider
                implementation="org.finos.legend.pure.intellij.debug.PureDapLaunchArgumentsProvider"/>
    </extensions>
</idea-plugin>
