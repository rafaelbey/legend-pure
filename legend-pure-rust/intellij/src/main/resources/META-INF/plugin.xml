<idea-plugin>
    <id>com.finos.legend.pure.intellij</id>
    <name>Legend Pure</name>
    <vendor>FINOS Legend</vendor>
    <description><![CDATA[
      Editor support for the Legend Pure language. Diagnostics, hover,
      go-to-definition, and document outline are served by the
      <code>legend lsp</code> binary (Rust); the plugin wires that
      server in via LSP4IJ.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="LegendPure"
            language="LegendPure"
            extensions="pure"
            implementationClass="com.finos.legend.pure.intellij.LegendPureFileType"
            fieldName="INSTANCE" />

        <fileType
            name="LegendPurem"
            extensions="purem"
            implementationClass="com.finos.legend.pure.intellij.LegendPuremFileType"
            fieldName="INSTANCE" />
    </extensions>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server
            id="legend-pure-lsp"
            name="Legend Pure"
            factoryClass="com.finos.legend.pure.intellij.lsp.LegendPureLspServerFactory">
            <description><![CDATA[
              Language server for Legend Pure. Spawns
              <code>legend lsp</code> over stdio.
            ]]></description>
        </server>

        <fileNamePatternMapping
            patterns="*.pure"
            serverId="legend-pure-lsp"
            languageId="legend-pure" />
    </extensions>
</idea-plugin>
