import meta::pure::metamodel::relation::*;

Class meta::pure::metamodel::relation::TDS<T> extends meta::pure::metamodel::relation::Relation<T> // T is of RelationType kind
{
    rows : T[*];
    csv(){$this->tdsToCsv()} : String[1];
}

Class <<access.private>> meta::pure::metamodel::relation::TDSTuple
{
    values : meta::pure::functions::collection::List<Any>[*];
}

native function meta::pure::metamodel::relation::stringToTDS(s:String[1]):meta::pure::metamodel::relation::TDS<Any>[1];

native function meta::pure::metamodel::relation::tdsToCsv<T>(tds:meta::pure::metamodel::relation::TDS<T>[1]):String[1];

Class meta::pure::metamodel::relation::TDSRelationAccessor<T> extends meta::pure::metamodel::relation::RelationElementAccessor<T> // sourceElement is of type TDS<T>
{
}

function meta::pure::metamodel::relation::newTDSRelationAccessor<T>(tds:TDS<T>[1]):TDSRelationAccessor<T>[1]
{
  ^TDSRelationAccessor<T>(sourceElement = $tds);
}

function <<test.Test>> meta::pure::metamodel::relation::tests::testStringToTDSProducesCsvField():Boolean[1]
{
    assertEquals('a:Integer[1],b:Integer[1]\n1,2', stringToTDS('a, b\n1, 2').csv);
}

function <<test.Test>> meta::pure::metamodel::relation::tests::testStringToTDSWithTypes():Boolean[1]
{
    let tds = stringToTDS('a:Integer[1]\n1')->cast(@TDS<(a:Integer[1])>);
    assertEquals('a:Integer[1]\n1', $tds.csv);
}

function <<test.Test>> meta::pure::metamodel::relation::tests::testStringToTDSWithNulls():Boolean[1]
{
    let tds = stringToTDS('a,b,c\n2,c,true\n,,\nnull,null,null\n')->cast(@TDS<(a:Integer, b:String, c:Boolean)>);
    assertEquals('a:Integer,b:String,c:Boolean\n2,c,true\n,,\n,,', $tds.csv);
}

function <<test.Test>> meta::pure::metamodel::relation::tests::testStringToTDSPreservesHeaderOnlyCsv():Boolean[1]
{
    assertEquals('a:String,b:String', stringToTDS('a, b').csv);
}

function <<test.Test>> meta::pure::metamodel::relation::tests::testRowColumnAccess():Boolean[1]
{
    let tds = stringToTDS('a, b\n1, 2');
    assertError(|$tds.rows->cast(@(a:Integer, c:Integer)), 'Cast exception: (a:Integer, b:Integer) cannot be cast to (a:Integer, c:Integer)');
    let row = $tds.rows->cast(@(a:Integer, b:Integer))->at(0);
    assertEquals(1, $row.a->toOne()) && assertEquals(2, $row.b->toOne());
}