<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.finos.legend.pure</groupId>
        <artifactId>legend-pure-runtime</artifactId>
        <version>5.83.1-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>legend-pure-runtime-rust-evaluator-bindings-ap</artifactId>
    <packaging>jar</packaging>
    <name>Legend Pure - Runtime - Rust Evaluator - Bindings Annotation Processor</name>

    <description>
        Annotation processor that generates typed Java bindings for the
        Pure runtime by loading the libpure_rust_jni cdylib and calling
        into the legend-pure-java-codegen Rust crate. Apply via
        @PureBindings on a marker class in the consumer module.
    </description>

    <properties>
        <maven.compiler.release>11</maven.compiler.release>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
    </properties>

    <dependencies>
        <!--
            Self-contained on the annotation-processor classpath: the
            AP only talks to the JVM via AbstractProcessor and the cdylib
            via System.load + native methods.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.11.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        Disable AP discovery for our own compile —
                        otherwise javac would try to load this module's
                        own AP off its own classpath while it's still
                        being built (chicken-and-egg).
                    -->
                    <proc>none</proc>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
