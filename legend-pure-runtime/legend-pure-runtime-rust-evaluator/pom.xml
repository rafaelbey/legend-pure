<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.finos.legend.pure</groupId>
        <artifactId>legend-pure-runtime</artifactId>
        <version>5.83.1-SNAPSHOT</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>

    <artifactId>legend-pure-runtime-rust-evaluator</artifactId>
    <packaging>jar</packaging>
    <name>Legend Pure - Runtime - Rust Evaluator</name>

    <properties>
        <maven.compiler.release>11</maven.compiler.release>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <!--
            Absolute path to the libpure_rust_jni cdylib that the
            annotation processor System.loads at compile time. Defaults
            to the developer-host build under the workspace's debug dir.
            The legend.cdylib.ext property is supplied by the OS-detection
            profiles below; build with cargo build -p legend-pure-parser-jni
            before mvn compile.
        -->
        <legend.cdylib.path>${project.basedir}/../../legend-pure-rust/target/debug/libpure_rust_jni${legend.cdylib.ext}</legend.cdylib.path>
    </properties>

    <profiles>
        <profile>
            <id>os-mac</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <legend.cdylib.ext>.dylib</legend.cdylib.ext>
            </properties>
        </profile>
        <profile>
            <id>os-linux</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>Linux</name>
                </os>
            </activation>
            <properties>
                <legend.cdylib.ext>.so</legend.cdylib.ext>
            </properties>
        </profile>
        <profile>
            <id>os-win</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <legend.cdylib.ext>.dll</legend.cdylib.ext>
            </properties>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>org.eclipse.collections</groupId>
            <artifactId>eclipse-collections-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.collections</groupId>
            <artifactId>eclipse-collections</artifactId>
        </dependency>
        <!--
            The annotation processor JAR carries the @PureBindings
            annotation that M3Bootstrap imports. We need the API at
            compile time but not at runtime: scope=provided keeps it
            off this module's transitive classpath and out of the
            runtime artifact.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>legend-pure-runtime-rust-evaluator-bindings-ap</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.11.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Java bindings are generated by an annotation processor
                that loads libpure_rust_jni and calls into the Rust
                java-codegen crate. The processor JAR is on
                annotationProcessorPaths only — not on the runtime
                classpath of this module. To skip generation entirely
                (e.g. on a host without a built cdylib), pass
                -Dmaven.compiler.proc=none.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>${project.groupId}</groupId>
                            <artifactId>legend-pure-runtime-rust-evaluator-bindings-ap</artifactId>
                            <version>${project.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Apure.cdylib.path=${legend.cdylib.path}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
