# Copyright 2026 Goldman Sachs
#
# Manifest of Pure elements to materialise as Java bindings via the
# `legend-pure-runtime-rust-evaluator-bindings-ap` annotation processor
# (or, equivalently, the `legend java-bindings --bindings-file` CLI).
#
# Format:
#   @<directive>: <value>     - directive lines, parsed before FQN body.
#                               Supported keys:
#                                 @pkg              - Java root package
#                                 @functions-class  - facade simple name
#                                 @import           - classpath path to
#                                                     another `.jpure`
#                                                     manifest whose FQNs
#                                                     are referenced (not
#                                                     re-emitted here)
#   <pure-fqn>                - one Pure fully-qualified name per line.
#                               Resolved against the platform model and
#                               dispatched by element kind:
#                                 Function     → static-method wrapper
#                                                on the facade class
#                                 Class        → Java interface
#                                                (property closure walked)
#                                 Association  → both endpoint classes
#                                                seeded; injected
#                                                properties surface on
#                                                each side's interface
#   # ...                     - comment line (ignored)
#   <blank>                   - ignored

@pkg: org.finos.legend.pure.rust.generated

###############################################################################
# M3 metamodel classes — the core "what is a class?" / "what is a property?"
# graph that downstream tooling traverses reflectively.
#
# Two M3 types are *not* listed here because the codegen handles them
# specially:
#   * `meta::pure::metamodel::type::Any` — the universal supertype.
#     Substituted with the hand-written `org.finos.legend.pure.rust.proxy.Any`
#     interface; every generated interface extends it transitively.
#   * `meta::pure::metamodel::type::Nil` — the bottom type. Rendered
#     as Java `Void` (always `null`), since a `Nil`-typed return can
#     never carry a real value.
###############################################################################
meta::pure::metamodel::type::Type
meta::pure::metamodel::type::Class
meta::pure::metamodel::type::PrimitiveType
meta::pure::metamodel::type::Enumeration

# Generic types
meta::pure::metamodel::type::generics::GenericType
meta::pure::metamodel::type::generics::TypeParameter

# Functions / properties
meta::pure::metamodel::function::Function
meta::pure::metamodel::function::FunctionDefinition
meta::pure::metamodel::function::ConcreteFunctionDefinition
meta::pure::metamodel::function::LambdaFunction
meta::pure::metamodel::function::property::Property
meta::pure::metamodel::function::property::QualifiedProperty

# Relationships
meta::pure::metamodel::relationship::Association
meta::pure::metamodel::relationship::Generalization

# Multiplicity
meta::pure::metamodel::multiplicity::Multiplicity

# Annotations / extension
meta::pure::metamodel::extension::Profile
meta::pure::metamodel::extension::Stereotype
meta::pure::metamodel::extension::Tag
meta::pure::metamodel::extension::TaggedValue
meta::pure::metamodel::extension::AnnotatedElement
meta::pure::metamodel::extension::Annotation
meta::pure::metamodel::extension::ElementWithTaggedValues
meta::pure::metamodel::extension::ElementWithStereotypes

# Packageable structure
meta::pure::metamodel::PackageableElement
meta::pure::metamodel::ModelElement
meta::pure::metamodel::Referenceable
meta::pure::metamodel::ReferenceUsage

###############################################################################
# Useful metadata functions — reflection over the metamodel from user code.
# These take `Any` and return one of the M3 classes above.
###############################################################################
# `$x->type()` returns the runtime classifier as a Type.
meta::pure::functions::meta::type_Any_MANY__Type_1_

# `$x->genericType()` returns the parameterised type (carrying type args).
meta::pure::functions::meta::genericType_Any_MANY__GenericType_1_

# `$x->elementToPath()` returns the FQN string of a PackageableElement.
meta::pure::functions::meta::elementToPath_PackageableElement_1__String_1_

# `$path->pathToElement()` is the inverse — resolves an FQN string to
# the PackageableElement registered at that path.
meta::pure::functions::meta::pathToElement_String_1__PackageableElement_1_
